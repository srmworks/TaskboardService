# TEMPLATE ONLY - not applied by scripts/deploy.sh.
# The real secret is created with a random password, so no credential is stored in Git:
#
#   kubectl -n taskboard create secret generic postgres-secret \
#     --from-literal=POSTGRES_USER=taskboard \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 18)" \
#     --from-literal=POSTGRES_DB=taskboard
#
# Only the postgres StatefulSet and task-service reference this Secret.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: taskboard
type: Opaque
stringData:
  POSTGRES_USER: taskboard
  POSTGRES_PASSWORD: CHANGE_ME
  POSTGRES_DB: taskboard
